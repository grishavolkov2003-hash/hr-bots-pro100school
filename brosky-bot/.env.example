# Telethon: my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Строка сессии Telethon (StringSession) - ОТДЕЛЬНЫЙ аккаунт от hr-bot
# ("Михаил" вместо "Григория"), генерируется отдельным скриптом логина
TELEGRAM_SESSION_STRING=

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Username менеджера, которому LLM шлёт "СИГНАЛ МЕНЕДЖЕРУ" (без @)
MANAGER_USERNAME=tutor_zelimhan

# Путь к service account JSON для Google Sheets
GOOGLE_SHEETS_CREDS=google_creds.json

# Файл с картинкой задания (используется в fallback-отправке, если ссылка не сработала)
ZADANIE_PATH=zadanie.jpg

# Путь к SQLite базе - на сервере это симлинк на /opt/hr-bot/candidates.db
# (общая база кандидатов между обоими ботами), не отдельный файл
DB_PATH=candidates.db

# brosky-bot НЕ запускает свой manager_bot.py/hr-manager-bot.service -
# BOT_TOKEN (python-telegram-bot) сюда не нужен, только в hr-bot/.env
