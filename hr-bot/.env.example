# Telethon: my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Строка сессии Telethon (StringSession) - генерируется один раз через
# отдельный скрипт логина, живёт только в .env, не в БД/репозитории
TELEGRAM_SESSION_STRING=

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Username менеджера, которому LLM шлёт "СИГНАЛ МЕНЕДЖЕРУ" (без @)
MANAGER_USERNAME=tutor_zelimhan

# Путь к service account JSON для Google Sheets (относительно рабочей
# директории бота, если не абсолютный)
GOOGLE_SHEETS_CREDS=google_creds.json

# Файл с картинкой задания, которую бот шлёт кандидатам
ZADANIE_PATH=zadanie.jpg

# Путь к SQLite базе кандидатов (общая между hr-bot и brosky-bot через
# симлинк на сервере - см. README)
DB_PATH=candidates.db

# Токен Telegram Bot API для менеджерского бота (manager_bot.py,
# hr-manager-bot.service) - получается у @BotFather, ОТДЕЛЬНЫЙ от
# TELEGRAM_API_ID/HASH выше (те - для Telethon-аккаунта, этот - для бота)
BOT_TOKEN=
